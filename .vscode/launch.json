{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Standup on demo-app",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extension", "${workspaceFolder}/demo-app"],
      "outFiles": ["${workspaceFolder}/extension/out/**/*.js"],
      "preLaunchTask": "build standup"
    }
  ]
}
