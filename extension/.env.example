# Copy to .env (git-ignored) and fill in what you have. Everything is optional:
# missing keys fall back to something that still works for a demo.

# Agents. Without it, the agents use this machine's Claude Code login.
ANTHROPIC_API_KEY=

# Voices. Without it, agents speak with built-in macOS voices.
CARTESIA_API_KEY=
CARTESIA_VOICE_LEAD=
CARTESIA_VOICE_FRONTEND=
CARTESIA_VOICE_BACKEND=
CARTESIA_VOICE_TESTS=
# CARTESIA_MODEL=sonic-2
# CARTESIA_VERSION=2025-04-16

# Push-to-talk speech-to-text (also needs: brew install sox). Without it, you type.
DEEPGRAM_API_KEY=
# DEEPGRAM_LANGUAGE=en

# Away mode phone calls. Without them, Away mode asks in the panel instead.
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# BOLNA_FROM_NUMBER=
STANDUP_PHONE=+91XXXXXXXXXX
